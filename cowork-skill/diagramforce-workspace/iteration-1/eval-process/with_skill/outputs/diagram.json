        "z": 3007,
        "source": { "id": "t_fin", "port": "port-right" },
        "target": { "id": "gw2", "port": "port-left" },
        "router": { "name": "sfManhattan" },
        "connector": { "name": "rounded", "args": { "radius": 8 } }
