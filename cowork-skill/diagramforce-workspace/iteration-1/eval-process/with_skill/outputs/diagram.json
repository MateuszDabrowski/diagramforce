{
  "version": 1,
  "appVersion": "1.20.1",
  "title": "Expense Approval Process",
  "diagramType": "process",
  "graph": {
    "cells": [
      {
        "id": "header",
        "type": "sf.TextLabel",
        "position": { "x": 520, "y": 0 },
        "size": { "width": 560, "height": 32 },
        "z": 2000,
        "attrs": {
          "label": {
            "x": "calc(0.5 * w)", "y": "calc(0.5 * h)",
            "textAnchor": "middle", "textVerticalAnchor": "middle",
            "fontSize": 16,
            "fontFamily": "system-ui, -apple-system, sans-serif",
            "fill": "var(--text-primary)", "fontWeight": "600",
            "text": "Expense Approval Process - from submission to notification"
          }
        }
      },

      {
        "id": "start",
        "type": "sf.BpmnEvent",
        "eventType": "start",
        "position": { "x": 40, "y": 256 },
        "size": { "width": 48, "height": 48 },
        "z": 2000,
        "attrs": { "label": { "text": "Expense submitted" } }
      },
      {
        "id": "t1",
        "type": "sf.BpmnTask",
        "taskType": "user",
        "position": { "x": 180, "y": 246 },
        "size": { "width": 150, "height": 68 },
        "z": 2000,
        "attrs": { "label": { "text": "1. Employee submits expense report" } }
      },
      {
        "id": "t2",
        "type": "sf.BpmnTask",
        "taskType": "user",
        "position": { "x": 430, "y": 246 },
        "size": { "width": 160, "height": 68 },
        "z": 2000,
        "attrs": { "label": { "text": "2. Manager reviews report" } }
      },
      {
        "id": "gw1",
        "type": "sf.BpmnGateway",
        "gatewayType": "exclusive",
        "position": { "x": 680, "y": 254 },
        "size": { "width": 52, "height": 52 },
        "z": 2000,
        "attrs": { "marker": { "text": "×" }, "label": { "text": "Under $500?" } }
      },

      {
        "id": "t_auto",
        "type": "sf.BpmnTask",
        "taskType": "service",
        "position": { "x": 820, "y": 86 },
        "size": { "width": 160, "height": 68 },
        "z": 2000,
        "attrs": { "label": { "text": "3. Auto-approve expense" } }
      },

      {
        "id": "t_fin",
        "type": "sf.BpmnTask",
        "taskType": "user",
        "position": { "x": 820, "y": 426 },
        "size": { "width": 170, "height": 68 },
        "z": 2000,
        "attrs": { "label": { "text": "3. Finance reviews expense" } }
      },
      {
        "id": "gw2",
        "type": "sf.BpmnGateway",
        "gatewayType": "exclusive",
        "position": { "x": 1090, "y": 434 },
        "size": { "width": 52, "height": 52 },
        "z": 2000,
        "attrs": { "marker": { "text": "×" }, "label": { "text": "Finance decision?" } }
      },

      {
        "id": "notify",
        "type": "sf.BpmnTask",
        "taskType": "send",
        "position": { "x": 1290, "y": 246 },
        "size": { "width": 180, "height": 68 },
        "z": 2000,
        "attrs": { "label": { "text": "4. Notify employee of outcome" } }
      },
      {
        "id": "end",
        "type": "sf.BpmnEvent",
        "eventType": "end",
        "position": { "x": 1560, "y": 256 },
        "size": { "width": 48, "height": 48 },
