          <mxGeometry x="40" y="130" width="170" height="80" as="geometry" />
        </mxCell>

        <!-- Salesforce Sales Cloud -->
        <mxCell id="n_salescloud" value="Sales Cloud&#10;(CRM)&#10;&#10;Lead capture &amp; qualification" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;verticalAlign=middle;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="290" y="120" width="190" height="100" as="geometry" />
