        </mxCell>
        <mxCell id="bg_analytics" value="Data &amp; Analytics Platform" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#faf5ff;strokeColor=#9673a6;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontStyle=1;fontSize=12;fontColor=#7d5b96;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="520" y="330" width="560" height="180" as="geometry" />
        </mxCell>

        <!-- ===================== NODES ===================== -->
