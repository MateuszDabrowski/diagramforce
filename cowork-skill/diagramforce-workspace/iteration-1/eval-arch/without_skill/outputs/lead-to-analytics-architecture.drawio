        <mxCell id="e_web_sc" value="Lead capture&#10;Web-to-Lead / REST API&#10;(real-time)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;strokeColor=#4a6fa5;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n_website" target="n_salescloud">
