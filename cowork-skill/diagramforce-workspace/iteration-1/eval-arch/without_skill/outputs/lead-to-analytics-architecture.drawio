        </mxCell>

        <!-- Snowflake Data Warehouse -->
        <mxCell id="n_snowflake" value="Snowflake&#10;Data Warehouse&#10;&#10;Central analytics store" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
