          <mxGeometry x="560" y="130" width="150" height="80" as="geometry" />
        </mxCell>

        <!-- Marketing Cloud Engagement -->
        <mxCell id="n_mce" value="Marketing Cloud&#10;Engagement (MCE)&#10;&#10;Journeys &amp; email" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontStyle=1;verticalAlign=middle;arcSize=10;" vertex="1" parent="1">
